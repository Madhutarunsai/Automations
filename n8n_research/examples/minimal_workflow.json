{
  "name": "Webhook → Transform → Slack",
  "nodes": [
    {
      "id": "a1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "c7b3d9f2-8a1e-4f6c-bb82-9e2f0a1d4c3a",
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "a2",
      "name": "Edit Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, 300],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "u1", "name": "email", "value": "={{$json.body.email.trim().toLowerCase()}}", "type": "string" },
            { "id": "u2", "name": "source", "value": "webhook", "type": "string" },
            { "id": "u3", "name": "receivedAt", "value": "={{$now.toISO()}}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a3",
      "name": "Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [800, 300],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "value": "C0123456789", "mode": "id" },
        "text": "=New lead: {{$json.email}} via {{$json.source}}",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": { "id": "5", "name": "Slack workspace" }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[ { "node": "Edit Fields", "type": "main", "index": 0 } ]]
    },
    "Edit Fields": {
      "main": [[ { "node": "Slack", "type": "main", "index": 0 } ]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "pinData": {},
